<mxfile host="app.diagrams.net">
  <diagram name="Strategy pattern - pricing" id="strat1">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="&lt;b&gt;EchoEats – Strategy pattern for dynamic pricing (F-08, F-09)&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="200" y="10" width="700" height="30" as="geometry"/>
        </mxCell>

        <!-- FoodListing -->
        <mxCell id="fl" value="FoodListing" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="260" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="fl1" value="- listingId : String&#xa;- name : String&#xa;- basePrice : double&#xa;- minPrice : double&#xa;- expiryTime : DateTime&#xa;- strategy : PricingStrategy" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;whiteSpace=wrap;html=0;" vertex="1" parent="fl">
          <mxGeometry y="26" width="260" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="fl2" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;" vertex="1" parent="fl">
          <mxGeometry y="122" width="260" height="8" as="geometry"/>
        </mxCell>
        <mxCell id="fl3" value="+ getCurrentPrice() : double&#xa;+ setStrategy(s : PricingStrategy) : void" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;whiteSpace=wrap;html=0;" vertex="1" parent="fl">
          <mxGeometry y="130" width="260" height="60" as="geometry"/>
        </mxCell>

        <!-- PricingStrategy interface -->
        <mxCell id="ps" value="«interface»&#xa;PricingStrategy" style="swimlane;fontStyle=3;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="480" y="100" width="420" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="ps1" value="+ calculatePrice(basePrice : double, minPrice : double, timeRemaining : int) : double" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;whiteSpace=wrap;html=0;" vertex="1" parent="ps">
          <mxGeometry y="40" width="420" height="40" as="geometry"/>
        </mxCell>

        <!-- Linear -->
        <mxCell id="lp" value="LinearPricing" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="360" y="330" width="210" height="66" as="geometry"/>
        </mxCell>
        <mxCell id="lp1" value="+ calculatePrice(...) : double" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;whiteSpace=wrap;html=0;" vertex="1" parent="lp">
          <mxGeometry y="26" width="210" height="40" as="geometry"/>
        </mxCell>

        <!-- Exponential -->
        <mxCell id="ep" value="ExponentialPricing" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="585" y="330" width="210" height="66" as="geometry"/>
        </mxCell>
        <mxCell id="ep1" value="- decayRate : double&#xa;+ calculatePrice(...) : double" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;whiteSpace=wrap;html=0;" vertex="1" parent="ep">
          <mxGeometry y="26" width="210" height="40" as="geometry"/>
        </mxCell>

        <!-- Stepped -->
        <mxCell id="sp" value="SteppedPricing" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="810" y="330" width="210" height="66" as="geometry"/>
        </mxCell>
        <mxCell id="sp1" value="- stepMinutes : int&#xa;+ calculatePrice(...) : double" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;whiteSpace=wrap;html=0;" vertex="1" parent="sp">
          <mxGeometry y="26" width="210" height="40" as="geometry"/>
        </mxCell>

        <!-- uses -->
        <mxCell id="e0" value="uses (1)" style="endArrow=open;endFill=0;html=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="fl" target="ps">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <!-- realizations -->
        <mxCell id="e1" style="endArrow=block;endFill=0;dashed=1;html=1;endSize=12;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="lp" target="ps">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" style="endArrow=block;endFill=0;dashed=1;html=1;endSize=12;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="ep" target="ps">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" style="endArrow=block;endFill=0;dashed=1;html=1;endSize=12;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="sp" target="ps">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- note -->
        <mxCell id="note" value="Every strategy applies the vendor's minimum after the curve:&#xa;Price(t) = max(minPrice, basePrice × Decay(timeRemaining))&#xa;The vendor chooses the strategy on the Post Food screen (F-08)." style="shape=note;whiteSpace=wrap;html=0;size=14;align=left;spacingLeft=6;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="320" width="300" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="en" style="endArrow=none;dashed=1;html=1;" edge="1" parent="1" source="note" target="fl">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
